{"instance_id": "sqltr-04341", "question": "What are the task details, task ids, and project ids for the progrects that are detailed as 'omnis' or have at least 3 outcomes?", "gold_sql": "SELECT T1.task_details ,  T1.task_id ,  T2.project_id FROM Tasks AS T1 JOIN Projects AS T2 ON T1.project_id  =  T2.project_id WHERE T2.project_details  =  'omnis' UNION SELECT T1.task_details ,  T1.task_id ,  T2.project_id FROM Tasks AS T1 JOIN Projects AS T2 ON T1.project_id  =  T2.project_id JOIN Project_outcomes AS T3 ON T2.project_id  =  T3.project_id GROUP BY T2.project_id HAVING count(*)  >  2", "db_id": "tracking_grants_for_research", "db_path": "data/raw/spider_data/spider_data/database/tracking_grants_for_research/tracking_grants_for_research.sqlite", "schema": {"document_types": ["document_description", "document_type_code"], "documents": ["document_id", "document_type_code", "grant_id", "other_details", "response_received_date", "sent_date"], "grants": ["grant_amount", "grant_end_date", "grant_id", "grant_start_date", "organisation_id", "other_details"], "organisation_types": ["organisation_type", "organisation_type_description"], "organisations": ["organisation_details", "organisation_id", "organisation_type"], "project_outcomes": ["outcome_code", "outcome_details", "project_id"], "project_staff": ["date_from", "date_to", "other_details", "project_id", "role_code", "staff_id"], "projects": ["organisation_id", "project_details", "project_id"], "research_outcomes": ["outcome_code", "outcome_description"], "research_staff": ["employer_organisation_id", "staff_details", "staff_id"], "staff_roles": ["role_code", "role_description"], "tasks": ["eg agree objectives", "project_id", "task_details", "task_id"]}}
